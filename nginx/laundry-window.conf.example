server {
    listen 80;
    listen [::]:80;
    server_name laundry-window.local;

    # Change this if you copy the repository elsewhere.
    root /var/www/laundry-window/html;
    index index.html;
    autoindex off;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:css|js)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    # Keep dotfiles private if one is ever added to the web root.
    location ~ /\.(?!well-known(?:/|$)) {
        deny all;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    # The footer support button loads its script from Buy Me a Coffee's CDN and
    # injects inline styles plus the Bree Serif web font from Google Fonts.
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' https://cdnjs.buymeacoffee.com; font-src 'self' https://fonts.gstatic.com; connect-src https://spot.utilitarian.io; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'" always;
}
